# BatteryService.isOemCharger() reads /sys/class/oplus_chg/battery/voocchg_ing
# (labeled vendor_sysfs_usb_supply) to detect active VOOC fast-charging when
# config_oemFastChargerStatusPath is set to that node. Without this rule the
# read fails with avc: denied → BatteryService treats it as no-fast-charger →
# AOD never shows "VOOC Charging" even when the kernel does engage VOOC.
allow system_server vendor_sysfs_usb_supply:dir search;
# rw_file_perms (not just r_file_perms) so HealthInterfaceService can
# write `5` to /sys/class/oplus_mms/gauge/item_id before reading
# /sys/class/oplus_mms/gauge/data — required for the "show real
# charging power" toggle to read live battery current.
allow system_server vendor_sysfs_usb_supply:file rw_file_perms;

# HealthInterfaceService.setBypassChargingEnabled() binds to
# vendor.oplus.hardware.charger.ICharger/default and calls setChgConfig() —
# the only call path that actually opens the battery FET. The HAL service
# runs in hal_oplus_charger_aidl. system_server needs both `find` on the
# binder service and binder_call to the HAL domain.
allow system_server hal_oplus_charger_aidl_service:service_manager find;
binder_call(system_server, hal_oplus_charger_aidl)
